// Karkain-Microservices - independent service composition registry.
// Karkain Language v1.2.0 verified baseline (tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Scope boundary: this framework models service registration, health and
// declared dependencies in portable Karkain. It does not discover services
// over the network or manage OS processes.
//
// Registry representation: quadruples
//   [name, endpoint, health, dependencies-string, ...]
// Arrays are values; mutating functions return the updated registry.

// new_registry returns an empty service registry.
public func new_registry() {
    return []
}

// register_service adds or replaces a named service.
public func register_service(registry, name, endpoint) {
    let out = unregister_service(registry, name)
    out = push(out, name)
    out = push(out, endpoint)
    out = push(out, "unknown")
    out = push(out, "")
    return out
}

// unregister_service removes a named service.
public func unregister_service(registry, name) {
    let out = []
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            i = i + 4
        } else {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            out = push(out, registry[i + 2])
            out = push(out, registry[i + 3])
            i = i + 4
        }
    }
    return out
}

// service_count returns the number of registered services.
public func service_count(registry) {
    return len(registry) / 4
}

// has_service reports whether a service is registered.
public func has_service(registry, name) {
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            return true
        }
        i = i + 4
    }
    return false
}

// service_endpoint returns the declared endpoint or "".
public func service_endpoint(registry, name) {
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            return registry[i + 1]
        }
        i = i + 4
    }
    return ""
}

// service_health returns the health state or "missing".
public func service_health(registry, name) {
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            return registry[i + 2]
        }
        i = i + 4
    }
    return "missing"
}

// set_health updates the health state of a known service.
public func set_health(registry, name, state) {
    if has_service(registry, name) == false {
        return registry
    }
    let out = []
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            out = push(out, state)
            out = push(out, registry[i + 3])
        } else {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            out = push(out, registry[i + 2])
            out = push(out, registry[i + 3])
        }
        i = i + 4
    }
    return out
}

// set_dependencies declares a comma-separated dependency list.
public func set_dependencies(registry, name, deps) {
    if has_service(registry, name) == false {
        return registry
    }
    let out = []
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            out = push(out, registry[i + 2])
            out = push(out, deps)
        } else {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            out = push(out, registry[i + 2])
            out = push(out, registry[i + 3])
        }
        i = i + 4
    }
    return out
}

// depends_on reports whether a service declares a dependency.
public func depends_on(registry, name, dep) {
    let i = 0
    while (i < len(registry)) {
        if registry[i] == name {
            if contains(registry[i + 3], dep) {
                return true
            }
        }
        i = i + 4
    }
    return false
}

// healthy_services returns the names of healthy services.
public func healthy_services(registry) {
    let out = []
    let i = 0
    while (i < len(registry)) {
        if registry[i + 2] == "healthy" {
            out = push(out, registry[i])
        }
        i = i + 4
    }
    return out
}

// describe_service builds a one-line service diagnostic.
public func describe_service(registry, name) {
    if has_service(registry, name) == false {
        return name + " -> <missing>"
    }
    return name + "@" + service_endpoint(registry, name) + ":" + service_health(registry, name)
}

// ---------------------------------------------------------------------------
// Phase 2 additions. Phase 1 registry and dependency APIs are unchanged.
// All resilience behaviour is in-process; distributed discovery and IPC are
// BLOCKED by the absence of socket builtins in the verified v1.2.0 subset.

// new_metadata creates a service version metadata store.
public func new_metadata() {
    return []
}

// set_version records a service version.
public func set_version(metadata, name, version) {
    let out = []
    out = push(out, name)
    out = push(out, version)
    let i = 0
    while (i < len(metadata)) {
        if metadata[i] == name {
            i = i + 2
        } else {
            out = push(out, metadata[i])
            out = push(out, metadata[i + 1])
            i = i + 2
        }
    }
    return out
}

// service_version returns a recorded version or "".
public func service_version(metadata, name) {
    let i = 0
    while (i < len(metadata)) {
        if metadata[i] == name { return metadata[i + 1] }
        i = i + 2
    }
    return ""
}

// version_compatible compares equal-format version labels.
public func version_compatible(current, required) {
    return current >= required
}

// new_readiness creates a readiness store.
public func new_readiness() {
    return []
}

// mark_ready sets readiness for a service.
public func mark_ready(readiness, name, ready) {
    let out = []
    out = push(out, name)
    out = push(out, ready)
    let i = 0
    while (i < len(readiness)) {
        if readiness[i] == name {
            i = i + 2
        } else {
            out = push(out, readiness[i])
            out = push(out, readiness[i + 1])
            i = i + 2
        }
    }
    return out
}

// is_service_ready reports whether a service is ready.
public func is_service_ready(readiness, name) {
    let i = 0
    while (i < len(readiness)) {
        if readiness[i] == name {
            if readiness[i + 1] { return true }
        }
        i = i + 2
    }
    return false
}

// new_timeout_policy creates a timeout policy.
public func new_timeout_policy(limit) {
    let p = []
    p = push(p, limit)
    return p
}

// timeout_exceeded reports whether elapsed time exceeds a limit.
public func timeout_exceeded(policy, elapsed) {
    return elapsed > policy[0]
}

// new_retry_policy creates a bounded retry policy.
public func new_retry_policy(max_attempts, delay) {
    let p = []
    p = push(p, max_attempts)
    p = push(p, delay)
    return p
}

// service_should_retry reports whether another attempt is allowed.
public func service_should_retry(policy, attempts) {
    return attempts < policy[0]
}

// new_breaker creates a closed circuit breaker with a failure threshold.
public func new_breaker(threshold) {
    let b = []
    b = push(b, threshold)
    b = push(b, 0)
    b = push(b, 0)
    return b
}

// breaker_failure records a failure and returns an updated breaker.
public func breaker_failure(breaker) {
    let out = []
    out = push(out, breaker[0])
    out = push(out, breaker[1] + 1)
    out = push(out, breaker[2])
    return out
}

// breaker_success resets the failure count.
public func breaker_success(breaker) {
    let out = []
    out = push(out, breaker[0])
    out = push(out, 0)
    out = push(out, breaker[2] + 1)
    return out
}

// breaker_state returns "open" when the threshold is reached.
public func breaker_state(breaker) {
    if breaker[1] >= breaker[0] { return "open" }
    return "closed"
}

// classify_failure maps an error code to a resilience class.
public func classify_failure(code) {
    if code == 1 { return "transient" }
    if code == 2 { return "transient" }
    return "permanent"
}

// new_correlation creates a correlation store.
public func new_correlation() {
    return []
}

// set_correlation records a correlation id for a service call.
public func set_correlation(store, service, id) {
    let out = []
    out = push(out, service)
    out = push(out, id)
    let i = 0
    while (i < len(store)) {
        if store[i] == service {
            i = i + 2
        } else {
            out = push(out, store[i])
            out = push(out, store[i + 1])
            i = i + 2
        }
    }
    return out
}

// correlation_id returns a recorded id or "".
public func correlation_id(store, service) {
    let i = 0
    while (i < len(store)) {
        if store[i] == service { return store[i + 1] }
        i = i + 2
    }
    return ""
}

// shutdown_service marks a registered service as stopped.
public func shutdown_service(registry, name) {
    return set_health(registry, name, "stopped")
}

// new_service_config creates a service configuration store.
public func new_service_config() {
    return []
}

// set_service_config records a configuration value.
public func set_service_config(config, service, key, value) {
    let out = config
    out = push(out, service)
    out = push(out, key)
    out = push(out, value)
    return out
}

// service_config_value returns a configuration value or a fallback.
public func service_config_value(config, service, key, fallback) {
    let i = 0
    while (i < len(config)) {
        if config[i] == service {
            if config[i + 1] == key { return config[i + 2] }
        }
        i = i + 3
    }
    return fallback
}
